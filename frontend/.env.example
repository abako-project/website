# ============================================================
# Frontend environment variables for Abako
# ============================================================
# Copy this file as .env or .env.local before running Vite:
#   cp .env.example .env
#
# For local development you usually do not need to change anything.
# ============================================================

# Base URL for all external APIs (Adapter, Virto, Contracts).
# All three APIs live under this domain with CORS enabled in dev.
# Development: https://dev.abako.xyz
# Future production: https://abako.xyz (when available)
VITE_API_BASE_URL=https://dev.abako.xyz

# Express backend URL used as proxy/federate server.
# Leave empty if the frontend talks directly to the external APIs.
# Required for WebAuthn and the internal /api endpoints.
VITE_BACKEND_URL=https://dev.abako.xyz

# JSON-RPC endpoint for the Kreivo chain.
# Uses the hosted node at dev.abako.xyz for testing.
# Change it when pointing to your production node.
VITE_KREIVO_RPC_URL=https://dev.abako.xyz/kreivo
